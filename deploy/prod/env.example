# Copy to .env on the VPS (cp env.example .env). Non-secret; used for compose interpolation.
# Registry path of the images built by GitHub Actions (lowercase).
IMAGE_REGISTRY=ghcr.io/duyhoangptit/vsp-notification-platform
# Rewritten by deploy.sh on every deploy (git SHA). Set by hand only for a manual rollback.
IMAGE_TAG=latest
# Host port (bound to 127.0.0.1) that the host Nginx proxies to.
FRONTEND_PORT=8180
