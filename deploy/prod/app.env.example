# Template only — the real file is app.env ON THE VPS (chmod 600), never committed.
# Backend runtime config (Spring relaxed binding: PNH_FOO_BAR -> pnh.foo-bar).

# Database: dedicated user/DB in vinspeed-postgres (see README)
PNH_DB_USER=pnh
PNH_DB_PASSWORD=change-me
# PNH_DB_URL=jdbc:postgresql://vinspeed-postgres:5432/pnh   # only if the DB name differs

# Redis: same value as REDIS_PASSWORD of the vinspeed infra .env
PNH_REDIS_PASSWORD=change-me

# Crypto: openssl rand -base64 32 — keep a backup, losing it makes stored secrets unreadable
PNH_MASTER_KEY=change-me
PNH_MASTER_KEY_ID=k1

# Public URL of the console (alert e-mail links)
PNH_CONSOLE_BASE_URL=https://notification.example.com

# Fallback SMTP for alert e-mails (Mailpit of the infra stack; switch to real SMTP for real mail)
PNH_ALERTING_FALLBACK_SMTP_HOST=vinspeed-mailpit
PNH_ALERTING_FALLBACK_SMTP_PORT=1025
PNH_ALERTING_FALLBACK_SMTP_FROM=pnh-alerts@vinspeed.local

# Swagger UI / OpenAPI docs (off in production)
PNH_API_DOCS_ENABLED=false
