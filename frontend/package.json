    "@mantine/tiptap": "8.3.18",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
